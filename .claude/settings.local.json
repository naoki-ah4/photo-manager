    "deny": [
      "Bash(bun run deploy:*)",
      "Read(.env.*)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(**/*token*)",
      "Read(.dev.vars)",
      "Read(wrangler.jsonc)",
      "Read(wrangler.toml)",
      "Write(.env*)",
      "Write(**/secrets/**)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(psql:*)",
      "Bash(mysql:*)",
      "Bash(mongod:*)"
    ],
    "ask": ["Bash(git push:*)", "Read(**/*key*)"]
  }
}
