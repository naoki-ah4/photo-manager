{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(bun run:*)",
      "Bash(bun test:*)",
      "Bash(cat:*)",
      "Bash(git:*)",
      "Bash(grep:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(find:*)",
      "Bash(less:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(diff:*)",
      "Bash(mkdir:*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "Bash(cargo check:*)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:v2.tauri.app)",
      "WebFetch(domain:tauri.app)",
      "WebFetch(domain:docs.tauri.app)",
      "WebFetch(domain:v1.tauri.app)",
      "Bash(bunx tsc:*)",
      "Bash(gh api:*)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:api.npmjs.org)",
      "Bash(bunx biome:*)"
